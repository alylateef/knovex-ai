# ==============================================================================
# Knovex AI — Environment Configuration
# Copy this file to .env and fill in your values.
# ==============================================================================

# Application
APP_NAME=Knovex AI
APP_ENV=development
DEBUG=true
SECRET_KEY=change-this-to-a-random-secret-key-minimum-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Server
HOST=127.0.0.1
PORT=8000

# ------------------------------------------------------------------------------
# PostgreSQL Database (via Docker Compose — see docker-compose.yml)
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@localhost:5432/knovex_ai
DATABASE_SYNC_URL=postgresql+psycopg://postgres:postgrespassword@localhost:5432/knovex_ai

# ------------------------------------------------------------------------------
# Redis (Token revocation & Rate limiting — via Docker Compose)
# ------------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# Qdrant Vector Database (via Docker Compose)
# ------------------------------------------------------------------------------
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=knovex_documents

# ------------------------------------------------------------------------------
# Embedding Models (run locally on CPU — downloaded automatically)
# ------------------------------------------------------------------------------
HF_HOME=D:/knovex-data/huggingface
FASTEMBED_CACHE_DIR=D:/knovex-data/fastembed
DENSE_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
SPARSE_MODEL_NAME=Qdrant/bm25

# Reranker (CrossEncoder — improves retrieval quality)
ENABLE_RERANKER=true
RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_TOP_K=5
RETRIEVAL_CANDIDATE_LIMIT=12

# ------------------------------------------------------------------------------
# LLM: Groq (free tier available at https://console.groq.com/keys)
# ------------------------------------------------------------------------------
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# LLM Fallback: xAI Grok (optional)
XAI_API_KEY=
GROK_MODEL=grok-2-latest
GROK_TEMPERATURE=0.0
GROK_MAX_TOKENS=512

# ------------------------------------------------------------------------------
# File Storage & Ingestion
# ------------------------------------------------------------------------------
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_SIZE_BYTES=15728640
CHUNK_SIZE=800
CHUNK_OVERLAP=150
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# ------------------------------------------------------------------------------
# LangSmith Observability & Tracing (LLM, RAG Pipeline & Cost Tracking)
# Get your free API key at: https://smith.langchain.com/settings
# ------------------------------------------------------------------------------
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=lsv2_pt_your_langsmith_api_key_here
LANGCHAIN_PROJECT=knovex-ai
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
